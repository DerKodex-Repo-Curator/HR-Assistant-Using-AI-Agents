# Copy this file to .env and fill in your real values.
# .env is gitignored; .env.example is committed as a template.

# OpenAI API key for chat completion and embeddings.
# Get one from https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-replace-with-your-real-key

# Optional. Defaults below if not set.
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Qdrant vector store. The project ships with docker-compose defaults
# (localhost:6334). Override if your Qdrant runs elsewhere.
# QDRANT_HOST=localhost
# QDRANT_PORT=6334
